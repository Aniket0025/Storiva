# Environment Mode (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# Frontend URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
MONGODB_URI=mongodb://localhost:27017/storiva

# Authentication JWT Configuration
JWT_SECRET=super_secret_storiva_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# AES-256 Encryption Key for Provider Credentials (32-byte hex key)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth Credentials (Phase 5/6)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/cloud-accounts/google/callback
